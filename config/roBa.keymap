#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// #includeのあとのあたりにスクロール量を変更

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    //automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        shut_down: shut_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp U &kp U>;
            label = "SHUT_DOWN";
        };

        sleep: sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp U &kp S>;
            label = "SLEEP";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        //  behaviors に追加
        // 新しいスクロール動作の追加

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                        &kp T                                                          &kp Y        &kp U  &kp I      &kp O         &kp P
&kp A      &kp S         &kp D         &kp F                        &kp G        &mkp MB3                           &kp EQUAL      &kp H        &kp J  &kp K      &kp L         &lt 3 MINUS
&kp Z      &kp X         &kp C         &kp V                        &kp B        &kp LEFT_SHIFT                     &kp GRAVE      &kp N        &kp M  &kp COMMA  &lt 5 PERIOD  &lt 4 SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 INT_HENKAN  &lt 2 SPACE  &lt_to_layer_0 3 INT_MUHENKAN      &kp BACKSPACE  &lt 1 ENTER                                  &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        FUNCTION {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9                          &kp N7  &kp N8  &kp N9  &kp ASTERISK  &kp SLASH
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans      &kp PERIOD  &kp N4  &kp N5  &kp N6  &kp PLUS      &kp MINUS
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans      &kp N0      &kp N1  &kp N2  &kp N3  &trans        &trans
&trans  &trans   &trans  &trans  &trans  &trans      &trans      &trans                                &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM {
            bindings = <
&trans  &trans  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS                                               &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SQT        &kp DOUBLE_QUOTES  &kp INT_YEN
&trans  &trans  &kp DOLLAR       &kp PERCENT   &kp CARET             &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SEMICOLON  &kp COLON          &kp TILDE
&trans  &trans  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp EQUAL                    &kp ESCAPE      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LESS_THAN  &kp GREATER_THAN   &kp PIPE
&trans  &trans  &trans           &trans        &trans                &trans                       &trans          &trans                                                                         &trans
            >;
        };

        ARROW {
            bindings = <
&kp PRINTSCREEN  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)                         &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)      &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)      &kp LC(LS(T))
&kp HOME         &kp PG_UP           &kp LC(LS(TAB))     &kp UP_ARROW      &kp LC(TAB)          &trans       &kp HOME  &kp PG_UP           &kp LG(LC(LEFT_ARROW))  &kp UP_ARROW      &kp LC(LG(RIGHT_ARROW))  &trans
&kp END          &kp PAGE_DOWN       &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &kp ESC      &kp END   &kp PG_DN           &kp LEFT_ARROW          &kp DOWN_ARROW    &kp RIGHT_ARROW          &trans
&trans           &trans              &trans              &trans            &trans               &trans       &trans    &trans                                                                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &kp LC(L)  &kp LA(LEFT_ARROW)  &mkp MB3     &kp LA(RIGHT_ARROW)  &kp LC(LS(T))
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(E)         &kp LC(T)  &kp LC(LS(TAB))     &kp LG(TAB)  &kp LC(TAB)          &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(NUMBER_1)  &kp LC(W)  &mkp MB1            &mkp MB2     &trans               &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans            &trans                                                           &kp LA(F4)
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans      &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&sleep      &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&shut_down  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans      &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DEC C_BRI_INC>;
        };
    };
};
