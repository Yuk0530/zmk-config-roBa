#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// #includeのあとのあたりにスクロール量を変更

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "NEW_MACRO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        //  behaviors に追加
        // 新しいスクロール動作の追加
        // 設定したいレイヤー

        sensor-bindings = <&scroll_up_down>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                        &kp T                                                          &kp Y        &kp U  &kp I      &kp O         &kp P
&kp A      &kp S         &kp D         &kp F                        &kp G        &kp LS(LG(S))                      &kp EQUAL      &kp H        &kp J  &kp K      &kp L         &lt 3 MINUS
&kp Z      &kp X         &kp C         &kp V                        &kp B        &kp LEFT_SHIFT                     &kp COMMA      &kp N        &kp M  &kp COMMA  &lt 5 PERIOD  &lt 4 SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 INT_HENKAN  &lt 2 SPACE  &lt_to_layer_0 3 INT_MUHENKAN      &kp BACKSPACE  &lt 1 ENTER                                  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        FUNCTION {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9                          &kp N7  &kp N8  &kp N9  &kp ASTERISK  &kp SLASH
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans      &kp PERIOD  &kp N4  &kp N5  &kp N6  &kp PLUS      &kp MINUS
&trans  &kp F10  &kp F1  &kp F2  &kp F3  &trans      &kp N0      &kp N1  &kp N2  &kp N3  &trans        &trans
&trans  &trans   &trans  &trans  &trans  &trans      &trans      &trans                                &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS                                               &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE      &kp LEFT_PARENTHESIS  &kp NON_US_BACKSLASH
&kp SLASH                   &kp KP_NUMBER_4  &kp DOLLAR       &kp PERCENT   &kp LCTRL             &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SEMICOLON  &kp SQT               &kp UNDERSCORE
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp EQUAL                    &kp ESCAPE      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COLON      &kp DOUBLE_QUOTES     &kp PIPE
&trans                      &trans           &trans           &trans        &trans                &trans                       &trans          &trans                                                                            &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &trans         &trans          &trans          &trans                                 &trans     &trans           &trans          &trans           &kp LC(LS(T))
&kp HOME    &kp PG_UP      &trans          &kp UP_ARROW    &trans           &trans      &kp HOME  &kp LC(T)  &kp LC(LS(TAB))  &kp UP_ARROW    &kp LC(TAB)      &trans
&kp END     &kp PAGE_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans      &kp END   &kp LC(W)  &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans      &trans         &trans          &trans          &trans           &trans      &trans    &trans                                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &trans  &kp LA(LEFT_ARROW)      &mkp MB3     &kp LA(RIGHT_ARROW)      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(E)         &trans  &kp LC(LG(LEFT_ARROW))  &kp LG(TAB)  &kp LC(LG(RIGHT_ARROW))  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(NUMBER_1)  &trans  &mkp MB1                &mkp MB2     &trans                   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans            &trans                                                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
